	<group name="GroupKeypad">
		<element ref="KeyCalcMode" name="lamp7" inputtag="BUTTONS" inputmask="0x080">
			<bounds x="0" y="0" width="4" height="4" />
		</element>
		<element ref="KeyPrintAll" name="lamp1" inputtag="BUTTONS" inputmask="0x002">
			<bounds x="5" y="0" width="4" height="4" />
		</element>
		<element ref="KeyTrace"    name="lamp3" inputtag="BUTTONS" inputmask="0x008">
			<bounds x="10" y="0" width="4" height="4" />
		</element>
		<element ref="KeyBreak"    name="lamp5" inputtag="BUTTONS" inputmask="0x020">
			<bounds x="15" y="0" width="4" height="4" />
		</element>

		<!-- Missing Lamp at x=0, y=5 name="lamp6" -->
		<element ref="KeyNoPrint"  name="lamp0" inputtag="BUTTONS" inputmask="0x001">
			<bounds x="5" y="5" width="4" height="4" />
		</element>
		<element ref="KeyContinue" name="lamp4" inputtag="BUTTONS" inputmask="0x010">
			<bounds x="10" y="5" width="4" height="4" />
		</element>
		<element ref="KeyStep"     name="lamp2" inputtag="BUTTONS" inputmask="0x004">
			<bounds x="15" y="5" width="4" height="4" />
		</element>
	</group>

	<group name="GroupStatus">
		<element ref="StatusRunning"  name="lamp8">
			<bounds x="0" y="0" width="2" height="2" />
		</element>
		<element ref="StatusLineOverflow"  name="lamp9">
			<bounds x="0" y="2" width="2" height="2" />
		</element>
		<element ref="StatusDegRad"  name="lamp10">
			<bounds x="0" y="4" width="2" height="2" />
		</element>
		<element ref="StatusOnline"  name="lamp11">
			<bounds x="0" y="6" width="2" height="2" />
		</element>
	</group>

	<group name="GroupLabel">
		<element ref="LabelRunning">
			<bounds x="0" y="0" width="2" height="2" />
		</element>
		<element ref="LabelLineOverflow">
			<bounds x="0" y="2" width="2" height="2" />
		</element>
		<element ref="LabelDegRad">
			<bounds x="0" y="4" width="2" height="2" />
		</element>
		<element ref="LabelOnline">
			<bounds x="0" y="6" width="2" height="2" />
		</element>
	</group>

	<view name="Default Layout">
		<bounds left="0" top="0" right="460" bottom="140" />

		<screen index="0">
			<bounds x="10" y="10" width="444" height="14" />
		</screen>

		<collection name="GroupKeypad">
			<group ref="GroupKeypad">
				<bounds x="10" y="35" width="120" height="60" />
			</group>
		</collection>

		<collection name="GroupStatus">
			<group ref="GroupStatus">
				<bounds x="160" y="35" width="15" height="60" />
			</group>
		</collection>

		<collection name="GroupLabel">
			<group ref="GroupLabel">
				<bounds x="180" y="35" width="60" height="60" />
			</group>
		</collection>

	</view>
</mamelayout>
