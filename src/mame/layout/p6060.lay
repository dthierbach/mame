			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
		<text string="Running" align="1">
			<bounds yc="0.5" height="0.8" left="0.1" right="3.9" />
			<color red="1.0" green="1.0" blue="1.0" />
		</text>
