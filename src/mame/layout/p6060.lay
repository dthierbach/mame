<mamelayout version="2">

	<element name="nothing"><rect><color alpha="0" /></rect></element>

	<element name="KeyNoPrint">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="No   ">
			<bounds left="0.1" top="0.1" right="0.9" bottom="0.45" />
			<color red="1" green="1" blue="1" />
		</text>
		<text string="Print">
			<bounds left="0.1" top="0.55" right="0.9" bottom="0.9" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="KeyPrintAll">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="Print">
			<bounds left="0.1" top="0.1" right="0.9" bottom="0.45" />
			<color red="1" green="1" blue="1" />
		</text>
		<text string="All  ">
			<bounds left="0.1" top="0.55" right="0.9" bottom="0.9" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="KeyStep">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="Step ">
			<bounds left="0.1" top="0.3" right="0.9" bottom="0.7" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="KeyTrace">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="Trace">
			<bounds left="0.1" top="0.3" right="0.9" bottom="0.7" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="KeyContinue">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="Con-">
			<bounds left="0.1" top="0.1" right="0.9" bottom="0.45" />
			<color red="1" green="1" blue="1" />
		</text>
		<text string="tinue">
			<bounds left="0.1" top="0.55" right="0.9" bottom="0.9" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="KeyBreak">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="Break">
			<bounds left="0.1" top="0.3" right="0.9" bottom="0.7" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="KeyCalcMode">
		<rect>
			<bounds left="0" top="0" right="1" bottom="1" />
			<color red="0.25" green="0.25" blue="0.25" />
		</rect>
		<rect state="0">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds left="0.05" top="0.05" right="0.95" bottom="0.95" />
			<color red="0.1" green="0.1" blue="0.1" />
		</rect>
		<text string="Calc ">
			<bounds left="0.1" top="0.1" right="0.9" bottom="0.45" />
			<color red="1" green="1" blue="1" />
		</text>
		<text string="Mode ">
			<bounds left="0.1" top="0.55" right="0.9" bottom="0.9" />
			<color red="1" green="1" blue="1" />
		</text>
	</element>

	<element name="StatusRunning">
		<disk>
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.5" green="0" blue="0.0" />
		</disk>
		<disk state="0">
			<bounds x="0.1" y="0.1" width="0.9" height="0.9" />
			<color red="0.2" green="0.0" blue="0.0" />
		</disk>
		<disk state="1">
			<bounds x="0.1" y="0.1" width="0.9" height="0.9" />
			<color red="1.0" green="0.0" blue="0.0" />
		</disk>
	</element>

	<group name="keypad">
		<element ref="KeyCalcMode" name="lamp7" inputtag="BUTTONS" inputmask="0x080">
			<bounds x="0" y="0" width="4" height="4" />
		</element>
		<element ref="KeyPrintAll" name="lamp1" inputtag="BUTTONS" inputmask="0x002">
			<bounds x="5" y="0" width="4" height="4" />
		</element>
		<element ref="KeyTrace"    name="lamp3" inputtag="BUTTONS" inputmask="0x008">
			<bounds x="10" y="0" width="4" height="4" />
		</element>
		<element ref="KeyBreak"    name="lamp5" inputtag="BUTTONS" inputmask="0x020">
			<bounds x="15" y="0" width="4" height="4" />
		</element>

		<!-- Missing Lamp at x=0, y=5 name="lamp6" -->
		<element ref="KeyNoPrint"  name="lamp0" inputtag="BUTTONS" inputmask="0x001">
			<bounds x="5" y="5" width="4" height="4" />
		</element>
		<element ref="KeyContinue" name="lamp4" inputtag="BUTTONS" inputmask="0x010">
			<bounds x="10" y="5" width="4" height="4" />
		</element>
		<element ref="KeyStep"     name="lamp2" inputtag="BUTTONS" inputmask="0x004">
			<bounds x="15" y="5" width="4" height="4" />
		</element>
	</group>

	<group name="status">
		<element ref="StatusRunning"  name="lamp8">
			<bounds x="0" y="0" width="2" height="2" />
		</element>
	</group>

	<view name="Default Layout">
		<bounds left="0" top="0" right="460" bottom="140" />

		<screen index="0">
			<bounds x="10" y="10" width="444" height="14" />
		</screen>

		<collection name="Keypad">
			<group ref="keypad">
				<bounds x="10" y="35" width="140" height="70" />
			</group>
		</collection>

		<collection name="Status">
			<group ref="status">
				<bounds x="160" y="35" width="30" height="30" />
			</group>
		</collection>

	</view>
</mamelayout>
